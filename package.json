{
  "name": "orchardist-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "daemon": "bun run packages/daemon/src/index.ts",
    "shell:dev": "bun run --cwd packages/shell dev",
    "build": "bun run --cwd packages/shell build && bun run --cwd packages/bridge build",
    "typecheck": "tsc --noEmit -p .",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test && bun run --cwd packages/bridge build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/bun": "^1.2.0",
    "typescript": "^5.9.0"
  }
}
