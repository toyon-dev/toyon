{
  "name": "toyon-monorepo",
  "private": true,
  "engines": {
    "bun": ">=1.4.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "daemon": "bun run packages/daemon/src/index.ts",
    "shell:dev": "bun run --cwd packages/shell dev",
    "build": "bun run --cwd packages/shell build && bun run --cwd packages/bridge build && bun scripts/stub.ts",
    "pack": "bun scripts/pack.ts",
    "version": "bun scripts/version.ts",
    "typecheck": "tsc --noEmit -p .",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun scripts/test.ts",
    "check": "bun scripts/check.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@types/bun": "^1.2.0",
    "postcss": "^8.5.28",
    "typescript": "^5.9.0"
  }
}
