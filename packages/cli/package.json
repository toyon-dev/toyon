{
  "name": "toyon",
  "version": "0.4.1",
  "description": "Toyon is where coding agents work on your web app while you check each change by using it. Every chat gets its own running copy with a live preview.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://toyon.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toyon-dev/toyon.git"
  },
  "bugs": "https://github.com/toyon-dev/toyon/issues",
  "keywords": [
    "ai",
    "agents",
    "claude-code",
    "codex",
    "opencode",
    "git",
    "worktree",
    "preview",
    "dev-server"
  ],
  "bin": {
    "toyon": "bin/toyon.js"
  },
  "files": [
    "bin",
    "dist",
    "cloud"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "scripts": {
    "prepublishOnly": "bun ../../scripts/pack.ts"
  },
  "dependencies": {
    "bun": "1.4.2",
    "bun-pty": "0.4.10"
  },
  "devDependencies": {
    "@toyon/shared": "workspace:*"
  }
}
